# Copy this file to .env and replace the placeholders with your private values.
# Never commit .env or share its contents.
GROQ_API_KEY=your-groq-api-key
DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@<session-pooler-host>:5432/postgres?sslmode=require

# Google OAuth web client credentials (keep the client secret private).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback
